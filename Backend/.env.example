# Environment Configuration for Dhatu Rakshana
APP_NAME=Dhatu Rakshana
APP_ENV=development
DEBUG=True
LOG_LEVEL=INFO

# Networking & CORS
API_V1_PREFIX=/api/v1
HOST=0.0.0.0
PORT=8000
CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173","http://localhost:3000","http://127.0.0.1:3000","http://localhost:8000","http://127.0.0.1:8000"]

# Database: Self-contained, zero-infrastructure local SQLite by default
DATABASE_URL=sqlite:///./data/dhatu_rakshana.db
# Optional production PostgreSQL example:
# DATABASE_URL=postgresql+psycopg2://postgres:postgres@localhost:5432/marine_defect_db

# Security & JWT
JWT_SECRET_KEY=dhatu-rakshana-secure-jwt-secret-key-change-in-production-2026
SECRET_KEY=dhatu-rakshana-secure-jwt-secret-key-change-in-production-2026
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# Local Storage
STORAGE_BACKEND=local
STORAGE_DIR=storage
STORAGE_BUCKET=marine-inspections
TOPOLOGY_STORAGE_DIR=storage/topology


# ML / CV Runtime
ML_DEVICE=auto
DEFAULT_MODEL_NAME=marine_hybrid_v1
CONFIDENCE_THRESHOLD=0.45
MAX_IMAGE_UPLOAD_SIZE_MB=50
MAX_IMAGES_PER_INSPECTION=20
RECONSTRUCTION_MAX_DIM=220

# PDF Report
REPORT_TITLE=DEFENSE PLATFORM COATING DEFECT INSPECTION AUDIT REPORT
ORGANIZATION=DEFENSE MARINE COATING STANDARDS AUTHORITY
