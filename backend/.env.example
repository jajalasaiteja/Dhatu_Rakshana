# Database Connection
DATABASE_URL=postgresql+psycopg2://postgres:postgres@localhost:5432/marine_defect_db

# Local storage mimicking S3 bucket/key paths
STORAGE_DIR=./storage

# Config path for grading thresholds
GRADING_CONFIG_PATH=./config/grading_thresholds.yaml

# CORS allowed origins
CORS_ORIGINS=http://localhost:5173,http://localhost:3000,http://127.0.0.1:5173
