# Dhatu Rakshana Frontend Environment Configuration Template
# Development default: empty VITE_API_BASE_URL enables smart dynamic origin targeting.
# When empty:
# - Under Vite dev server (port 5173/3000), dynamically connects to http://<hostname>:8000
# - Under FastAPI production standalone serving (port 8000 or custom), uses relative URLs ("")
# If deploying backend to a remote standalone host, specify explicit base URL (e.g. https://api.example.com).
VITE_API_BASE_URL=
VITE_API_PREFIX=/api/v1
