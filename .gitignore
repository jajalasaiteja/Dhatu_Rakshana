# ============================================================
# Dhatu Rakshana — .gitignore
# FastAPI (Python) + React (Node/Vite) + SQLite
# ============================================================

# ------------------------------------------------------------
# Python / Backend
# ------------------------------------------------------------
__pycache__/
*.py[cod]
*.pyo
*.pyd
*.so
*.egg
*.egg-info/
dist/
build/
.eggs/
.Python
pip-log.txt
pip-delete-this-directory.txt

# Virtual environments
.venv/
venv/
env/
ENV/
.env

# Environment variable files
*.env
.env.*
!.env.example

# pytest / coverage
.pytest_cache/
.coverage
.coverage.*
htmlcov/
coverage.xml

# mypy / type checkers
.mypy_cache/
.dmypy.json
dmypy.json
.pytype/
.ruff_cache/

# Jupyter
.ipynb_checkpoints/
*.ipynb

# ------------------------------------------------------------
# Database
# ------------------------------------------------------------
*.db
*.sqlite
*.sqlite3
data/*.db
data/*.sqlite3

# ------------------------------------------------------------
# Storage / Runtime data
# ------------------------------------------------------------
storage/
data/storage/
uploads/
media/

# ML model weights (large binary files)
*.pt
*.pth
*.onnx
*.weights
*.h5
*.pkl
*.joblib
runs/
models/weights/

# ------------------------------------------------------------
# Node / Frontend
# ------------------------------------------------------------
node_modules/
Frontend/node_modules/
Frontend/dist/
Frontend/.vite/
Frontend/build/

# npm / yarn / pnpm lockfile conflicts (keep one)
# Uncomment the ones you don't use:
# package-lock.json
# yarn.lock
# pnpm-lock.yaml

# Vite cache
.vite/

# ------------------------------------------------------------
# IDE / Editor
# ------------------------------------------------------------
.vscode/
.idea/
*.swp
*.swo
*~
.DS_Store
Thumbs.db

# ------------------------------------------------------------
# OS
# ------------------------------------------------------------
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Desktop.ini

# ------------------------------------------------------------
# Logs
# ------------------------------------------------------------
*.log
logs/
*.out

# ------------------------------------------------------------
# Secrets / Keys
# ------------------------------------------------------------
*.pem
*.key
*.crt
*.p12
*.pfx
secrets.json
secrets.yaml

# ------------------------------------------------------------
# Miscellaneous
# ------------------------------------------------------------
*.bak
*.tmp
*.temp
.cache/
